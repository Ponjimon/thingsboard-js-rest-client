{
  "name": "thingsboard-js-rest-client",
  "version": "4.1.0",
  "description": "ThingsBoard REST API client for JavaScript/TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "dev": "tsc --watch"
  },
  "keywords": [
    "thingsboard",
    "iot",
    "rest-client",
    "typescript",
    "javascript"
  ],
  "author": "ThingsBoard <info@thingsboard.io>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.17.1",
  "homepage": "https://thingsboard.io/docs/reference/js-rest-client/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ponjimon/thingsboard-js-rest-client.git"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "jsonwebtoken": "^9.0.2"
  }
}
